; The kernel32.dll functions that the host, sokol, Clay and miniaudio call.
; Names from mingw-w64-crt/lib-common/kernel32.def.in.
LIBRARY "kernel32.dll"
EXPORTS
AcquireSRWLockExclusive
AcquireSRWLockShared
AllocConsole
AttachConsole
CloseHandle
CreateEventA
CreateFileA
CreateFileW
CreateSemaphoreA
CreateThread
ExitProcess
FindClose
FindFirstFileW
FindNextFileW
FlushFileBuffers
FreeLibrary
GetCommandLineW
GetConsoleMode
GetConsoleOutputCP
GetEnvironmentVariableW
GetFileAttributesExW
GetFileInformationByHandle
GetFileInformationByHandleEx
GetFileSizeEx
GetFileType
GetFinalPathNameByHandleW
GetFullPathNameW
GetLastError
GetModuleHandleA
GetModuleHandleW
GetProcAddress
GetProcessHeap
GetStdHandle
GetSystemInfo
GlobalAlloc
GlobalFree
GlobalLock
GlobalUnlock
HeapAlloc
HeapFree
HeapReAlloc
LoadLibraryA
LocalFree
MultiByteToWideChar
OutputDebugStringA
PeekNamedPipe
QueryPerformanceCounter
QueryPerformanceFrequency
RaiseException
ReadFile
ReleaseSRWLockExclusive
ReleaseSRWLockShared
ReleaseSemaphore
ResetEvent
RtlFillMemory
RtlMoveMemory
SetConsoleOutputCP
SetEvent
SetFilePointer
SetHandleInformation
SetThreadPriority
Sleep
VirtualAlloc
VirtualFree
VirtualProtect
WaitForSingleObject
WideCharToMultiByte
WriteFile
