// Bakes one TTF into an SDF atlas of ASCII 32 to 126 and writes it as Odin source.
package font_bake

import "core:fmt"
import "core:os"
import "core:strings"
import stbtt "vendor:stb/truetype"

FIRST :: 32
LAST :: 126
// The engine keys a kern pair by two characters of one byte each.
#assert(LAST < 256)
BAKE_SIZE :: 32
ATLAS_WIDTH :: 256
// stb_truetype's suggested values: 5 pixels of field outside the edge, 2 inside.
SDF_PADDING :: 5
SDF_ON_EDGE :: 180
SDF_DIST_SCALE :: f32(SDF_ON_EDGE) / SDF_PADDING
// Clear space between glyphs, so linear filtering never reads a neighbour.
GAP :: 1

Glyph :: struct {
	advance: f32,
	bearing: [2]int,
	size:    [2]int,
	pixels:  []u8,
}

main :: proc() {
	if len(os.args) != 3 {
		fmt.eprintln("usage: font_bake <font.ttf> <out.odin>")
		os.exit(2)
	}
	font_path, out_path := os.args[1], os.args[2]
	ttf, read_err := os.read_entire_file_from_path(font_path, context.allocator)
	if read_err != nil {
		fmt.eprintfln("font_bake: cannot read %s: %v", font_path, read_err)
		os.exit(1)
	}
	info: stbtt.fontinfo
	if !stbtt.InitFont(&info, raw_data(ttf), 0) {
		fmt.eprintfln("font_bake: %s is not a font stb_truetype reads", font_path)
		os.exit(1)
	}
	source := bake(&info, font_path)
	if err := os.write_entire_file(out_path, transmute([]u8)source); err != nil {
		fmt.eprintfln("font_bake: cannot write %s: %v", out_path, err)
		os.exit(1)
	}
}

bake :: proc(info: ^stbtt.fontinfo, font_path: string) -> string {
	scale := stbtt.ScaleForPixelHeight(info, BAKE_SIZE)
	ascent, descent, line_gap: i32
	stbtt.GetFontVMetrics(info, &ascent, &descent, &line_gap)

	glyphs: [LAST - FIRST + 1]Glyph
	sizes: [len(glyphs)][2]int
	for &glyph, i in glyphs {
		codepoint := rune(FIRST + i)
		advance, left_bearing: i32
		stbtt.GetCodepointHMetrics(info, codepoint, &advance, &left_bearing)
		glyph.advance = f32(advance) * scale
		w, h, xoff, yoff: i32
		bitmap := stbtt.GetCodepointSDF(info, scale, i32(codepoint), SDF_PADDING, SDF_ON_EDGE, SDF_DIST_SCALE, &w, &h, &xoff, &yoff)
		if bitmap != nil {
			glyph.pixels = make([]u8, w * h)
			copy(glyph.pixels, bitmap[:w * h])
			stbtt.FreeSDF(bitmap, nil)
			glyph.size = {int(w), int(h)}
			glyph.bearing = {int(xoff), int(yoff)}
		}
		sizes[i] = glyph.size
	}

	rects: [len(glyphs)][4]int
	height := pack_shelves(sizes[:], ATLAS_WIDTH, rects[:])
	atlas := make([]u8, ATLAS_WIDTH * height)
	for glyph, i in glyphs {
		x, y, w, h := rects[i].x, rects[i].y, rects[i].z, rects[i].w
		for row in 0 ..< h {
			copy(atlas[(y + row) * ATLAS_WIDTH + x:][:w], glyph.pixels[row * w:][:w])
		}
	}

	b := strings.builder_make()
	fmt.sbprintfln(&b, "// Generated by scripts/font_bake from %s. Do not edit.", font_path)
	fmt.sbprintln(&b, "// Rebuild with: roc scripts/build.roc -- font")
	fmt.sbprintln(&b, "package engine")
	fmt.sbprintln(&b)
	fmt.sbprintfln(&b, "FONT_FIRST :: %d", FIRST)
	fmt.sbprintfln(&b, "FONT_LAST :: %d", LAST)
	fmt.sbprintfln(&b, "FONT_BAKE_SIZE :: f32(%d)", BAKE_SIZE)
	fmt.sbprintfln(&b, "FONT_ASCENT :: f32(%v)", f32(ascent) * scale)
	fmt.sbprintfln(&b, "FONT_LINE_HEIGHT :: f32(%v)", f32(ascent - descent + line_gap) * scale)
	fmt.sbprintfln(&b, "FONT_SDF_ON_EDGE :: %d", SDF_ON_EDGE)
	fmt.sbprintfln(&b, "FONT_SDF_DIST_SCALE :: f32(%v)", SDF_DIST_SCALE)
	fmt.sbprintfln(&b, "FONT_ATLAS_WIDTH :: %d", ATLAS_WIDTH)
	fmt.sbprintfln(&b, "FONT_ATLAS_HEIGHT :: %d", height)
	fmt.sbprintln(&b)
	fmt.sbprintln(&b, "@(rodata)")
	fmt.sbprintln(&b, "FONT_GLYPHS := [FONT_LAST - FONT_FIRST + 1]Font_Glyph{")
	for glyph, i in glyphs {
		r := rects[i]
		fmt.sbprintfln(
			&b,
			"\t{{advance = %v, bearing = {{%d, %d}}, rect = {{%d, %d, %d, %d}}}}, // %q",
			glyph.advance, glyph.bearing.x, glyph.bearing.y, r.x, r.y, r.z, r.w, rune(FIRST + i),
		)
	}
	fmt.sbprintln(&b, "}")
	fmt.sbprintln(&b)
	write_kerning(&b, info, scale)
	fmt.sbprintln(&b)
	fmt.sbprintln(&b, "@(rodata)")
	fmt.sbprintln(&b, "FONT_ATLAS := [FONT_ATLAS_WIDTH * FONT_ATLAS_HEIGHT]u8{")
	for row in 0 ..< height {
		fmt.sbprint(&b, "\t")
		for x in 0 ..< ATLAS_WIDTH {
			fmt.sbprintf(&b, "%d,", atlas[row * ATLAS_WIDTH + x])
		}
		fmt.sbprintln(&b)
	}
	fmt.sbprintln(&b, "}")
	return strings.to_string(b)
}

// Walking first then second keeps the table sorted by pair, so the engine can binary search it.
write_kerning :: proc(b: ^strings.Builder, info: ^stbtt.fontinfo, scale: f32) {
	pairs: [dynamic]string
	for first in rune(FIRST) ..= LAST {
		for second in rune(FIRST) ..= LAST {
			kern := stbtt.GetCodepointKernAdvance(info, first, second)
			if kern != 0 {
				append(&pairs, fmt.tprintf("\t{{pair = 0x%04x, advance = %v}}, // %q", int(first) << 8 | int(second), f32(kern) * scale, fmt.tprintf("%c%c", first, second)))
			}
		}
	}
	fmt.sbprintln(b, "@(rodata)")
	fmt.sbprintfln(b, "FONT_KERNING := [%d]Font_Kern{{", len(pairs))
	for line in pairs {
		fmt.sbprintln(b, line)
	}
	fmt.sbprintln(b, "}")
}

// Places each rect left to right in rows. A rect of size zero gets the empty rect at the origin.
pack_shelves :: proc(sizes: [][2]int, width: int, rects: [][4]int) -> (height: int) {
	x, y, shelf := 0, 0, 0
	for size, i in sizes {
		if size.x == 0 || size.y == 0 {
			rects[i] = {}
			continue
		}
		if x + size.x > width {
			x = 0
			y += shelf + GAP
			shelf = 0
		}
		rects[i] = {x, y, size.x, size.y}
		x += size.x + GAP
		shelf = max(shelf, size.y)
		height = max(height, y + size.y)
	}
	return height
}
