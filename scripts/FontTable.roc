FontTable := [].{
	baked_path : Str
	baked_path = "engine/font_baked.odin"

	module_path : Str
	module_path = "packages/ui/Font.roc"

	# Each Str number is Roc literal text, copied from the Odin text, so the
	# generated table holds the same f32 values as the host.
	Metrics : { first : U8, last : U8, bake_size : Str, line_height : Str, advances : List(Str), kerns : List({ first : U8, second : U8, advance : Str }) }

	parse_baked : Str -> Try(Metrics, [MissingConstant(Str), BadConstantLine(Str), BadGlyphLine(Str), BadKernLine(Str), GlyphCount(U64), ExponentNumber(Str)])
	parse_baked = |source| {
		var $section = Constants
		var $first = Missing
		var $last = Missing
		var $bake_size = Missing
		var $line_height = Missing
		var $advances = []
		var $kerns = []
		# A trim drops the \r of a CRLF checkout, so Font.roc is the same on every OS.
		for line in Str.split_on(source, "\n").map(Str.trim) {
			match $section {
				Glyphs =>
					if line == "}" {
						$section = Constants
					} else {
						$advances = $advances.append(glyph_advance(line)?)
					}
				Kerns =>
					if line == "}" {
						$section = Constants
					} else {
						$kerns = $kerns.append(kern(line)?)
					}
				Constants =>
					if Str.starts_with(line, "FONT_GLYPHS := [") {
						$section = Glyphs
					} else if Str.starts_with(line, "FONT_KERNING := [") {
						$section = Kerns
					} else {
						match Str.split_first(line, " :: ") {
							Ok({ before: "FONT_FIRST", after }) => {
								$first = Found(U8.from_str(after) ? |_| BadConstantLine(line))
							}
							Ok({ before: "FONT_LAST", after }) => {
								$last = Found(U8.from_str(after) ? |_| BadConstantLine(line))
							}
							Ok({ before: "FONT_BAKE_SIZE", after }) => {
								$bake_size = Found(f32_constant(line, after)?)
							}
							Ok({ before: "FONT_LINE_HEIGHT", after }) => {
								$line_height = Found(f32_constant(line, after)?)
							}
							_ => {}
						}
					}
			}
		}
		first = match $first {
			Found(value) => value
			Missing => return Err(MissingConstant("FONT_FIRST"))
		}
		last = match $last {
			Found(value) => value
			Missing => return Err(MissingConstant("FONT_LAST"))
		}
		bake_size = match $bake_size {
			Found(value) => value
			Missing => return Err(MissingConstant("FONT_BAKE_SIZE"))
		}
		line_height = match $line_height {
			Found(value) => value
			Missing => return Err(MissingConstant("FONT_LINE_HEIGHT"))
		}
		if last < first or $advances.len() != last.to_u64() - first.to_u64() + 1 {
			return Err(GlyphCount($advances.len()))
		}
		Ok({ first, last, bake_size, line_height, advances: $advances, kerns: $kerns })
	}

	font_module : Metrics -> Str
	font_module = |metrics| {
		advances = Str.join_with(metrics.advances.map(|advance| "\t\t${advance},\n"), "")
		var $rows = ""
		for char in metrics.first.to(metrics.last) {
			$rows = Str.concat($rows, kern_row(metrics.kerns.keep_if(|pair| pair.first == char)))
		}
		Str.join_with(
			[
				font_module_head,
				"\tfirst : U8\n\tfirst = ${metrics.first.to_str()}\n\n",
				"\tlast : U8\n\tlast = ${metrics.last.to_str()}\n\n",
				"\tbake_size : F32\n\tbake_size = ${metrics.bake_size}\n\n",
				"\tline_height : F32\n\tline_height = ${metrics.line_height}\n\n",
				"\t# The advance of each character from first to last, in pixels at bake_size.\n",
				"\tadvances : List(F32)\n\tadvances = [\n",
				advances,
				"\t]\n\n",
				"\t# Row i holds the kern pairs whose first character is first + i, in pixels at bake_size.\n",
				"\tkerns : List(List({ second : U8, advance : F32 }))\n\tkerns = [\n",
				$rows,
				"\t]\n}\n",
			],
			"",
		)
	}
}

font_module_head : Str
font_module_head =
	\\# Generated by roc scripts/build.roc -- font-table from engine/font_baked.odin. Do not edit.
	\\# Ui.measure reads it, so a game measures text with the host's numbers.
	\\Font := [].{
	\\

kern_row : List({ first : U8, second : U8, advance : Str }) -> Str
kern_row = |pairs| match pairs {
	[] => "\t\t[],\n"
	[pair] => "\t\t[${kern_record(pair)}],\n"
	_ => "\t\t[\n${Str.join_with(pairs.map(|pair| "\t\t\t${kern_record(pair)},\n"), "")}\t\t],\n"
}

kern_record : { first : U8, second : U8, advance : Str } -> Str
kern_record = |pair| "{ second: ${pair.second.to_str()}, advance: ${pair.advance} }"

# {advance = 7.225806, bearing = {0, 0}, rect = {0, 0, 0, 0}}, // ' '
glyph_advance : Str -> Try(Str, [BadGlyphLine(Str), ExponentNumber(Str)])
glyph_advance = |line| {
	after = Str.split_first(line, "{advance = ").map_ok(|parts| parts.after) ? |_| BadGlyphLine(line)
	text = Str.split_first(after, ",").map_ok(|parts| parts.before) ? |_| BadGlyphLine(line)
	number_text(text, BadGlyphLine(line))
}

# {pair = 0x2837, advance = 0.8}, // "(7"
kern : Str -> Try({ first : U8, second : U8, advance : Str }, [BadKernLine(Str), ExponentNumber(Str)])
kern = |line| {
	pair_text = Str.split_first(line, "{pair = ").map_ok(|parts| parts.after) ? |_| BadKernLine(line)
	hex = Str.split_first(pair_text, ",").map_ok(|parts| parts.before) ? |_| BadKernLine(line)
	pair = U16.from_str(hex) ? |_| BadKernLine(line)
	advance_text = Str.split_first(line, "advance = ").map_ok(|parts| parts.after) ? |_| BadKernLine(line)
	text = Str.split_first(advance_text, "}").map_ok(|parts| parts.before) ? |_| BadKernLine(line)
	advance = number_text(text, BadKernLine(line))?
	Ok({ first: pair.shr_zf_wrap(8).to_u8_wrap(), second: pair.to_u8_wrap(), advance })
}

# FONT_BAKE_SIZE :: f32(32)
f32_constant : Str, Str -> Try(Str, [BadConstantLine(Str), ExponentNumber(Str)])
f32_constant = |line, value|
	if Str.starts_with(value, "f32(") and Str.ends_with(value, ")") {
		number_text(Str.drop_suffix(Str.drop_prefix(value, "f32("), ")"), BadConstantLine(line))
	} else {
		Err(BadConstantLine(line))
	}

# Roc reads a number with no point as an integer, so 7 becomes 7.0. bad is the
# error for text that is not a number.
number_text : Str, [ExponentNumber(Str), ..others] -> Try(Str, [ExponentNumber(Str), ..others])
number_text = |text, bad|
	if Str.contains(text, "e") or Str.contains(text, "E") {
		Err(ExponentNumber(text))
	} else {
		match F32.from_str(text) {
			Ok(_) if Str.contains(text, ".") => Ok(text)
			Ok(_) => Ok("${text}.0")
			Err(_) => Err(bad)
		}
	}

# A \\ string reads escapes, so a backslash in the Odin text is written twice.
baked_sample : Str
baked_sample =
	\\FONT_FIRST :: 32
	\\FONT_LAST :: 34
	\\FONT_BAKE_SIZE :: f32(32)
	\\FONT_LINE_HEIGHT :: f32(32)
	\\FONT_GLYPHS := [FONT_LAST - FONT_FIRST + 1]Font_Glyph{
	\\	{advance = 7.225806, bearing = {0, 0}, rect = {0, 0, 0, 0}}, // ' '
	\\	{advance = 7, bearing = {-4, -23}, rect = {0, 0, 15, 29}}, // '!'
	\\	{advance = 7.7677417, bearing = {-4, -23}, rect = {16, 0, 16, 17}}, // '"'
	\\}
	\\FONT_KERNING := [2]Font_Kern{
	\\	{pair = 0x2122, advance = -0.5419355}, // "!\\""
	\\	{pair = 0x2221, advance = 0.8}, // "\\"!"
	\\}

## The sample parses to its numbers, with .0 on a whole number.
expect FontTable.parse_baked(baked_sample) == Ok({ first: 32, last: 34, bake_size: "32.0", line_height: "32.0", advances: ["7.225806", "7.0", "7.7677417"], kerns: [{ first: 33, second: 34, advance: "-0.5419355" }, { first: 34, second: 33, advance: "0.8" }] })

## CRLF line ends parse the same as LF.
expect FontTable.parse_baked(Str.join_with(Str.split_on(baked_sample, "\n"), "\r\n")) == FontTable.parse_baked(baked_sample)

## A file with no FONT_LAST is refused.
expect FontTable.parse_baked(Str.replace_first(baked_sample, "FONT_LAST", "FONT_END")) == Err(MissingConstant("FONT_LAST"))

## A constant that is not a number is refused.
expect FontTable.parse_baked(Str.replace_first(baked_sample, "f32(32)", "f32(big)")) == Err(BadConstantLine("FONT_BAKE_SIZE :: f32(big)"))

## A glyph table shorter than FONT_LAST - FONT_FIRST + 1 is refused.
expect FontTable.parse_baked(Str.replace_first(baked_sample, "FONT_LAST :: 34", "FONT_LAST :: 35")) == Err(GlyphCount(3))

## A glyph line with no advance is refused.
expect FontTable.parse_baked(Str.replace_first(baked_sample, "{advance = 7,", "{width = 7,")) == Err(BadGlyphLine("{width = 7, bearing = {-4, -23}, rect = {0, 0, 15, 29}}, // '!'"))

## A kern pair that is not hex is refused.
expect FontTable.parse_baked(Str.replace_first(baked_sample, "0x2122", "0xZZ")) == Err(BadKernLine("{pair = 0xZZ, advance = -0.5419355}, // \"!\\\"\""))

## A number in exponent form is refused, because the generator copies number text.
expect FontTable.parse_baked(Str.replace_first(baked_sample, "0.8}", "1e-05}")) == Err(ExponentNumber("1e-05"))

## The module groups the pairs by first character, one row per character.
expect {
	out = FontTable.parse_baked(baked_sample).map_ok(FontTable.font_module) ?? ""
	Str.contains(out, "\tkerns = [\n\t\t[],\n\t\t[{ second: 34, advance: -0.5419355 }],\n\t\t[{ second: 33, advance: 0.8 }],\n\t]\n")
		and Str.starts_with(out, "# Generated by roc scripts/build.roc -- font-table")
}

## A row with more than one pair stacks them, one per line.
expect {
	pairs = [{ first: 84, second: 97, advance: "-1.5" }, { first: 84, second: 111, advance: "-1.25" }]
	kern_row(pairs) == "\t\t[\n\t\t\t{ second: 97, advance: -1.5 },\n\t\t\t{ second: 111, advance: -1.25 },\n\t\t],\n"
}
