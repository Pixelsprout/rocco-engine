#+test
package engine

import "core:fmt"
import "core:math"
import "core:os"
import "core:strings"
import "core:testing"

TEXT_CORPUS_PATH :: "packages/ui/TextCorpus.roc"

TEXT_CORPUS_HEAD :: `# Generated by odin test engine from TEXT_CORPUS in engine/text_corpus_test.odin. Do not edit.
# Rebuild with: ROCCO_WRITE_TEXT_CORPUS=1 odin test engine -debug -define:ODIN_TEST_NAMES=engine.test_text_corpus_matches_packages_ui
import Ui

TextCorpus := [].{
	Case : { text : Str, size : F32, width : F32, measured : { width : F32, height : F32 }, lines : List(Str) }

	cases : List(Case)
	cases = [
`

TEXT_CORPUS_TAIL :: `	]
}

## Ui.measure gives the host's font_measure numbers for every corpus case.
expect TextCorpus.cases.keep_if(|c| Ui.measure(c.text, c.size) != c.measured).map(|c| c.text) == []

## Ui.wrap gives Clay's lines for every corpus case.
expect TextCorpus.cases.keep_if(|c| Ui.wrap(c.text, { size: c.size, width: c.width }) != c.lines).map(|c| c.text) == []

## Ui.fit never gives text wider than the width.
expect TextCorpus.cases.keep_if(|c| Ui.measure(Ui.fit(c.text, { size: c.size, width: c.width }), c.size).width > c.width).map(|c| c.text) == []
`

// Every size is whole, because the host rounds the size to whole pixels. The
// corpus leaves out a too-wide word that ends with a space before a newline:
// Clay gives that line a length of -1, and ui_push_text cannot slice it.
// "one two" at 20 is 55.419353 wide, so 55.415 is inside Clay's epsilon of
// 0.01 and stays on one line, and 55.4 is outside it and wraps.
@(rodata)
TEXT_CORPUS := [?]Text_Case {
	{"A", 32, 100},
	{"AV To Ty", 32, 1000},
	{"Hello world", 24, 1000},
	{"Hello world", 24, 80},
	{"The quick brown fox jumps over the lazy dog", 18, 120},
	{"04:41 owner.report owner-P2 if the reviewer finds a problem in the diff, fix it on branch phase3-hud-cut in a new commit", 18, 420},
	{"Supercalifragilistic is long", 16, 40},
	{"two  spaces  here", 20, 60},
	{"trailing space ", 20, 1000},
	{"trailing space ", 20, 70},
	{"line one\nline two", 20, 1000},
	{"a\n\nb", 20, 1000},
	{"naïve café über", 20, 60},
	{"Tab\there", 20, 1000},
	{"WWWWWWWW MMMMMMMM", 18, 100},
	{"To Vo Ty", 13, 30},
	{"Large text wraps", 48, 200},
	{"one two", 20, 55.415},
	{"one two", 20, 55.4},
}

Text_Case :: struct {
	text:        string,
	size, width: f32,
}

// The whole Roc module, in context.temp_allocator.
text_corpus_module :: proc(f: ^Frame_Fixture) -> string {
	b := strings.builder_make(context.temp_allocator)
	strings.write_string(&b, TEXT_CORPUS_HEAD)
	for c in TEXT_CORPUS {
		measured := font_measure(c.text, c.size)
		strings.write_string(&b, "\t\t{ text: ")
		text_corpus_roc_str(&b, c.text)
		strings.write_string(&b, ", size: ")
		text_corpus_roc_f32(&b, c.size)
		strings.write_string(&b, ", width: ")
		text_corpus_roc_f32(&b, c.width)
		strings.write_string(&b, ", measured: { width: ")
		text_corpus_roc_f32(&b, measured.x)
		strings.write_string(&b, ", height: ")
		text_corpus_roc_f32(&b, measured.y)
		strings.write_string(&b, " }, lines: [")
		for line, i in text_corpus_clay_lines(f, c) {
			if i > 0 {
				strings.write_string(&b, ", ")
			}
			text_corpus_roc_str(&b, line)
		}
		strings.write_string(&b, "] },\n")
	}
	strings.write_string(&b, TEXT_CORPUS_TAIL)
	return strings.to_string(b)
}

// Lays out the text in a Box of c.width and reads one line per row of the
// Box. Clay sends no Text command for an empty line, so its row stays "".
// The Roc_Str borrows c.text, because these tests set up no Roc heap.
text_corpus_clay_lines :: proc(f: ^Frame_Fixture, c: Text_Case) -> []string {
	box := ui_box()
	box.width = ui_fixed(c.width)
	box.background = RED
	str := Roc_Str{bytes = raw_data(c.text), length = uint(len(c.text))}
	text := Element{tag = .Text, payload = {text = {str = str, size = c.size, color = RED, wrap = .Words}}}
	roots := []Element{ui_box_of(box, text)}
	commands := ui_layout(f.ui, roots, f.window)
	line_height := FONT_LINE_HEIGHT * c.size / FONT_BAKE_SIZE
	lines: []string
	top: f32
	for command in commands {
		if command.commandType == .Rectangle {
			top = command.boundingBox.y
			lines = make([]string, int(math.round(command.boundingBox.height / line_height)), context.temp_allocator)
		}
	}
	for command in commands {
		if command.commandType != .Text {
			continue
		}
		row := int(math.round((command.boundingBox.y - top) / line_height))
		contents := command.renderData.text.stringContents
		if row < len(lines) {
			lines[row] = strings.clone(string(contents.chars[:contents.length]), context.temp_allocator)
		}
	}
	return lines
}

// Escapes what Roc reads as syntax in a string literal. Other bytes, such as
// UTF-8, are copied as they are.
text_corpus_roc_str :: proc(b: ^strings.Builder, s: string) {
	strings.write_byte(b, '"')
	for i in 0 ..< len(s) {
		c := s[i]
		switch c {
		case '\\':
			strings.write_string(b, `\\`)
		case '"':
			strings.write_string(b, `\"`)
		case '$':
			strings.write_string(b, `\$`)
		case '\n':
			strings.write_string(b, `\n`)
		case '\t':
			strings.write_string(b, `\t`)
		case 0 ..< 32:
			fmt.sbprintf(b, `\u(%x)`, c)
		case:
			strings.write_byte(b, c)
		}
	}
	strings.write_byte(b, '"')
}

// Roc reads a number with no point as an integer, so 32 becomes 32.0.
text_corpus_roc_f32 :: proc(b: ^strings.Builder, v: f32) {
	text := fmt.tprintf("%v", v)
	strings.write_string(b, text)
	if !strings.contains_rune(text, '.') {
		strings.write_string(b, ".0")
	}
}

@(test)
test_text_corpus_roc_str_escapes_what_roc_reads_as_syntax :: proc(t: ^testing.T) {
	defer free_all(context.temp_allocator)
	b := strings.builder_make(context.temp_allocator)
	text_corpus_roc_str(&b, "a$b\"c\\d\n\té")
	testing.expect_value(t, strings.to_string(b), `"a\$b\"c\\d\n\té"`)
	strings.builder_reset(&b)
	text_corpus_roc_str(&b, "\x01")
	testing.expect_value(t, strings.to_string(b), `"\u(1)"`)
}

@(test)
test_text_corpus_roc_f32_always_has_a_point :: proc(t: ^testing.T) {
	defer free_all(context.temp_allocator)
	cases := [?]struct {
		v:    f32,
		want: string,
	}{{32, "32.0"}, {0, "0.0"}, {16.154839, "16.154839"}}
	b := strings.builder_make(context.temp_allocator)
	for c in cases {
		strings.builder_reset(&b)
		text_corpus_roc_f32(&b, c.v)
		testing.expect_value(t, strings.to_string(b), c.want)
	}
}

@(test)
test_text_corpus_clay_lines_keeps_an_empty_line :: proc(t: ^testing.T) {
	defer free_all(context.temp_allocator)
	f: Frame_Fixture
	f.window = {size = {4096, 4096}, dpi = 1}
	frame_fixture_init_ui(&f)
	defer frame_fixture_destroy_ui(&f)

	blank := text_corpus_clay_lines(&f, {"a\n\nb", 20, 1000})
	testing.expect_value(t, len(blank), 3)
	if len(blank) == 3 {
		testing.expect_value(t, blank[0], "a")
		testing.expect_value(t, blank[1], "")
		testing.expect_value(t, blank[2], "b")
	}
	wrapped := text_corpus_clay_lines(&f, {"Hello world", 24, 80})
	testing.expect_value(t, len(wrapped), 2)
	if len(wrapped) == 2 {
		testing.expect_value(t, wrapped[0], "Hello")
		testing.expect_value(t, wrapped[1], "world")
	}
}

@(test)
test_text_corpus_matches_packages_ui :: proc(t: ^testing.T) {
	defer free_all(context.temp_allocator)
	f: Frame_Fixture
	f.window = {size = {4096, 4096}, dpi = 1}
	frame_fixture_init_ui(&f)
	defer frame_fixture_destroy_ui(&f)

	module := text_corpus_module(&f)
	if os.get_env("ROCCO_WRITE_TEXT_CORPUS", context.temp_allocator) == "1" {
		testing.expect_value(t, os.write_entire_file(TEXT_CORPUS_PATH, transmute([]u8)module), nil)
		return
	}
	data, err := os.read_entire_file(TEXT_CORPUS_PATH, context.temp_allocator)
	if !testing.expectf(t, err == nil, "cannot read %v: run odin test from the repository root", TEXT_CORPUS_PATH) {
		return
	}
	testing.expectf(t, string(data) == module, "%v differs from the host. Rebuild it with the command in its header.", TEXT_CORPUS_PATH)
}
