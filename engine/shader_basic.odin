/*
    #include <metal_stdlib>
    #include <simd/simd.h>

    using namespace metal;

    struct main0_out
    {
        float4 frag_color [[color(0)]];
    };

    fragment main0_out main0(texture2d<float> blit_tex [[texture(0)]], sampler blit_smp [[sampler(0)]], float4 gl_FragCoord [[position]])
    {
        main0_out out = {};
        out.frag_color = blit_tex.read(uint2(int2(gl_FragCoord.xy)), 0);
        return out;
    }

*/
