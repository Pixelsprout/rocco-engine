    static float4 gl_Position;
    static float3 pos;
    static float4 v_col;
    static float4 col;
    static float3 v_nrm;
    static float3 nrm;
    static float3 v_world;
    static float2 v_uv;
    static float2 uv;

    struct SPIRV_Cross_Input
    {
        float3 pos : TEXCOORD0;
        float4 col : TEXCOORD1;
        float3 nrm : TEXCOORD2;
        float2 uv : TEXCOORD3;
    };

    struct SPIRV_Cross_Output
    {
        float4 v_col : TEXCOORD0;
        float3 v_nrm : TEXCOORD1;
        float3 v_world : TEXCOORD2;
        float2 v_uv : TEXCOORD3;
        float4 gl_Position : SV_Position;
    };

    void vert_main()
    {
        float4 _31 = float4(pos, 1.0f);
        gl_Position = mul(_31, _19_mvp);
        v_col = col;
        v_nrm = mul(float4(nrm, 0.0f), _19_normal_model).xyz;
        v_world = mul(_31, _19_model).xyz;
        v_uv = uv;
    }

    SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
    {
        pos = stage_input.pos;
        col = stage_input.col;
        nrm = stage_input.nrm;
        uv = stage_input.uv;
        vert_main();
        SPIRV_Cross_Output stage_output;
        stage_output.gl_Position = gl_Position;
        stage_output.v_col = v_col;
        stage_output.v_nrm = v_nrm;
        stage_output.v_world = v_world;
        stage_output.v_uv = v_uv;
        return stage_output;
    }
