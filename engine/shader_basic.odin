/*
    #include <metal_stdlib>
    #include <simd/simd.h>

    using namespace metal;

    struct fs_params
    {
        float4 light_dir;
        float4 light_color;
        float4 ambient;
    };

    struct main0_out
    {
        float4 frag_color [[color(0)]];
    };

    struct main0_in
    {
        float4 v_col [[user(locn0)]];
        float3 v_nrm [[user(locn1)]];
    };

    fragment main0_out main0(main0_in in [[stage_in]], constant fs_params& _20 [[buffer(1)]])
    {
        main0_out out = {};
        out.frag_color = float4(in.v_col.xyz * (_20.ambient.xyz + (_20.light_color.xyz * fast::max(dot(fast::normalize(in.v_nrm), fast::normalize(_20.light_dir.xyz)), 0.0))), in.v_col.w);
        return out;
    }

*/
