	Free = 0,
	Locked = 1,
}

#assert(size_of(Roc_View_Cursor) == 1)
#assert(align_of(Roc_View_Cursor) == 1)


roc_init_arg0_decref :: proc(value: Roc_Init_Arg0) {
	roc_list_decref_roc_str(value.args)
	roc_list_decref_roc_str(value.assets)
}

roc_init_decref :: proc(value: Roc_Init) {
	roc_list_decref_roc_init_commands(value.commands)
}

roc_init_commands_decref :: proc(value: Roc_Init_Commands) {
	#partial switch value.tag {
	case .Load:
		roc_init_commands_load_decref(value.payload.load)
	case .Unload:
		roc_str_decref(value.payload.unload)
	}
}

roc_init_commands_load_decref :: proc(value: Roc_Init_Commands_Load) {
	roc_list_decref_roc_str(value.assets)
	roc_str_decref(value.pack)
}

roc_launch_decref :: proc(value: Roc_Launch) {
	roc_launch_window_decref(value.window)
}

roc_launch_window_decref :: proc(value: Roc_Launch_Window) {
	roc_str_decref(value.title)
}

roc_loaded_arg2_decref :: proc(value: Roc_Loaded_Arg2) {
	roc_str_decref(value.name)
}

roc_step_arg1_decref :: proc(value: Roc_Step_Arg1) {
	roc_list_decref_u16(value.held)
	roc_list_decref_u16(value.pressed)
}

roc_step_arg2_decref :: proc(value: Roc_Step_Arg2) {
	roc_list_decref_roc_step_arg2_contacts(value.contacts)
	roc_list_decref_roc_step_arg2_overlaps(value.overlaps)
	roc_list_decref_roc_step_arg2_rays(value.rays)
}

roc_view_decref :: proc(value: Roc_View) {
	roc_list_decref_roc_view_colliders(value.colliders)
	roc_list_decref_roc_view_draws(value.draws)
	roc_list_decref_roc_view_lights(value.lights)
	roc_list_decref_roc_view_loops(value.loops)
	roc_list_decref_roc_view_queries(value.queries)
	roc_list_decref_roc_vocabularyelement(value.ui)
}

roc_view_queries_decref :: proc(value: Roc_View_Queries) {
	#partial switch value.tag {
	case .Overlap:
		roc_view_queries_overlap_decref(value.payload.overlap)
	case .Raycast:
		roc_view_queries_raycast_decref(value.payload.raycast)
	}
}

roc_view_queries_overlap_decref :: proc(value: Roc_View_Queries_Overlap) {
	roc_list_decref_u64(value.exclude)
}

roc_view_queries_raycast_decref :: proc(value: Roc_View_Queries_Raycast) {
	roc_list_decref_u64(value.exclude)
}

roc_vocabularyelement_decref :: proc(value: Roc_VocabularyElement) {
	#partial switch value.tag {
	case .Box:
		roc_list_decref_roc_vocabularyelement(value.payload.box._1)
	case .Text:
		roc_vocabularyelement_text_decref(value.payload.text)
	}
}

roc_vocabularyelement_text_decref :: proc(value: Roc_VocabularyElement_Text) {
	roc_str_decref(value.str)
}

roc_list_decref_roc_str :: proc(list: Roc_List(Roc_Str)) {
	roc_list_decref_elements(list, roc_str_decref)
}

roc_list_from_slice_roc_str :: proc(elems: []Roc_Str) -> Roc_List(Roc_Str) {
	return roc_list_from_slice_with(elems, true)
}

roc_list_decref_roc_init_commands :: proc(list: Roc_List(Roc_Init_Commands)) {
	roc_list_decref_elements(list, roc_init_commands_decref)
}

roc_list_from_slice_roc_init_commands :: proc(elems: []Roc_Init_Commands) -> Roc_List(Roc_Init_Commands) {
