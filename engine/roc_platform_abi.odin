	roc_str_decref,
	roc_init_arg0_decref,
	roc_init_decref,
	roc_init_commands_decref,
	roc_init_commands_load_decref,
	roc_step_arg1_decref,
	roc_loaded_arg2_decref,
	roc_view_decref,
}

roc_list_decref :: proc {
