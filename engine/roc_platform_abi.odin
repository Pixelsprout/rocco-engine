roc_init_arg0_decref :: proc(value: Roc_Init_Arg0) {
	roc_list_decref_roc_str(value.args)
	roc_list_decref_roc_str(value.assets)
}

roc_init_decref :: proc(value: Roc_Init) {
	roc_list_decref_roc_init_commands(value.commands)
}

roc_init_commands_decref :: proc(value: Roc_Init_Commands) {
	#partial switch value.tag {
	case .Load:
		roc_init_commands_load_decref(value.payload.load)
	case .Log:
		roc_str_decref(value.payload.log)
	case .Tell:
		roc_init_commands_tell_decref(value.payload.tell)
	case .Unload:
		roc_str_decref(value.payload.unload)
	}
}

roc_init_commands_load_decref :: proc(value: Roc_Init_Commands_Load) {
	roc_list_decref_roc_str(value.assets)
	roc_str_decref(value.pack)
}

roc_init_commands_tell_decref :: proc(value: Roc_Init_Commands_Tell) {
	roc_str_decref(value.msg)
	roc_str_decref(value.port)
}

roc_launch_decref :: proc(value: Roc_Launch) {
	roc_launch_window_decref(value.window)
}

roc_launch_window_decref :: proc(value: Roc_Launch_Window) {
	roc_str_decref(value.title)
}

roc_loaded_arg2_decref :: proc(value: Roc_Loaded_Arg2) {
	roc_list_decref_roc_loaded_arg2_clips(value.clips)
	roc_str_decref(value.name)
}

roc_loaded_arg2_clips_decref :: proc(value: Roc_Loaded_Arg2_Clips) {
	roc_str_decref(value.name)
}

roc_step_arg1_decref :: proc(value: Roc_Step_Arg1) {
	roc_list_decref_roc_step_arg1_gamepads(value.gamepads)
	roc_list_decref_u16(value.held)
	roc_step_arg1_pointer_decref(value.pointer)
	roc_list_decref_u16(value.pressed)
}

roc_step_arg1_gamepads_decref :: proc(value: Roc_Step_Arg1_Gamepads) {
	roc_list_decref_u8(value.held)
	roc_list_decref_u8(value.pressed)
}

roc_step_arg1_pointer_decref :: proc(value: Roc_Step_Arg1_Pointer) {
	roc_list_decref_u8(value.held)
	roc_list_decref_u8(value.pressed)
	roc_list_decref_u8(value.released)
}

roc_step_arg2_decref :: proc(value: Roc_Step_Arg2) {
	roc_list_decref_roc_step_arg2_contacts(value.contacts)
	roc_list_decref_roc_step_arg2_overlaps(value.overlaps)
	roc_list_decref_roc_init_commands_tell(value.ports)
	roc_list_decref_roc_step_arg2_rays(value.rays)
	roc_step_arg2_ui_decref(value.ui)
}

roc_step_arg2_ui_decref :: proc(value: Roc_Step_Arg2_Ui) {
	roc_list_decref_u64(value.over)
	roc_list_decref_roc_step_arg2_ui_scroll(value.scroll)
}

roc_view_decref :: proc(value: Roc_View) {
	roc_list_decref_roc_view_emitters(value.emitters)
	roc_list_decref_roc_vocabularynode(value.nodes)
	roc_list_decref_roc_view_post(value.post)
	roc_list_decref_roc_view_queries(value.queries)
	roc_list_decref_roc_vocabularynode_draw_material_surface_surface(value.shader_values)
	roc_list_decref_roc_vocabularyelement(value.ui)
}

roc_vocabularynode_decref :: proc(value: Roc_VocabularyNode) {
	#partial switch value.tag {
	case .Attach:
		roc_vocabularynode_attach_0_decref(value.payload.attach._0)
		roc_list_decref_roc_vocabularynode(value.payload.attach._1)
	case .Draw:
		roc_vocabularynode_draw_decref(value.payload.draw)
	case .Group:
		roc_list_decref_roc_vocabularynode(value.payload.group._1)
	}
}

roc_vocabularynode_attach_0_decref :: proc(value: Roc_VocabularyNode_Attach_0) {
	roc_str_decref(value.joint)
}

roc_vocabularynode_draw_decref :: proc(value: Roc_VocabularyNode_Draw) {
	roc_vocabularynode_draw_ground_decref(value.ground)
	roc_vocabularynode_draw_material_decref(value.material)
	roc_list_decref_roc_vocabularynode_draw_materials(value.materials)
	roc_list_decref_roc_vocabularynode_draw_material_surface_surface(value.shader_values)
	roc_list_decref_roc_vocabularynode_draw_slotmaterials(value.slot_materials)
}

roc_vocabularynode_draw_ground_decref :: proc(value: Roc_VocabularyNode_Draw_Ground) {
	roc_list_decref_roc_str(value.feet)
}

roc_vocabularynode_draw_material_decref :: proc(value: Roc_VocabularyNode_Draw_Material) {
	roc_list_decref_roc_vocabularynode_draw_material_properties(value.properties)
	roc_vocabularynode_draw_material_surface_decref(value.surface)
	roc_list_decref_roc_vocabularynode_draw_material_textures(value.textures)
}

roc_vocabularynode_draw_material_surface_decref :: proc(value: Roc_VocabularyNode_Draw_Material_Surface) {
	#partial switch value.tag {
	case .Surface:
		roc_vocabularynode_draw_material_surface_surface_decref(value.payload.surface)
	}
}

roc_vocabularynode_draw_material_surface_surface_decref :: proc(value: Roc_VocabularyNode_Draw_Material_Surface_Surface) {
	roc_list_decref_roc_vocabularynode_draw_material_surface_surface_parameters(value.parameters)
	roc_vocabularynode_draw_material_surface_surface_shader_decref(value.shader)
