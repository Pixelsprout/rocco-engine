# Odin build output
engine/engine
engine/*.bin
*.dSYM/
engine.a
engine.bin
build/

# Roc platform link inputs. Built from engine/ or copied from sokol-odin/sokol/.
platform/targets/*/libhost.a
platform/targets/*/sokol_*.a
platform/targets/*/libclang_rt*.a
# CRT objects and shared libraries copied from the Linux image.
platform/targets/*/*.o
platform/targets/*/*.so*
# Host library, sokol libraries and SDK import libraries on Windows.
platform/targets/*/*.lib
platform/targets/*/*.pdb
# Generated from the installed SDK by scripts/make-macos-sysroot.sh.
platform/targets/macos-sysroot/
# Roc's linker output.
examples/*/*.bin
examples/*/*.exe
examples/*/*.pdb

.DS_Store
