# Odin build output
engine/engine
engine/*.bin
*.dSYM/
engine.a
engine.bin
build/

# Vendored floooh/sokol-odin clone with prebuilt archives. See README.
sokol/

# Roc platform link inputs. Built from engine/ or copied from sokol/.
platform/targets/*/libhost.a
platform/targets/*/sokol_*.a
platform/targets/*/libclang_rt*.a
# CRT objects and shared libraries copied from the Linux image.
platform/targets/*/*.o
platform/targets/*/*.so*
# Generated from the installed SDK by scripts/make-macos-sysroot.sh.
platform/targets/macos-sysroot/
# Roc's linker output.
examples/*/*.bin

.DS_Store
