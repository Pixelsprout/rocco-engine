# Odin build output
engine/engine
engine/*.bin
*.dSYM/
engine.a
engine.bin
build/

# Roc platform link inputs. Built from engine/ or copied from sokol-odin/sokol/ and clay/.
platform/targets/*/libhost.a
platform/targets/*/sokol_*.a
platform/targets/*/clay.a
platform/targets/*/libclang_rt*.a
# scripts/make_linux_stubs.py writes the committed x64glibc CRT objects and stubs.
platform/targets/*/*.o
platform/targets/*/*.so*
!platform/targets/x64glibc/*.o
!platform/targets/x64glibc/*.so.*
# Host library, sokol libraries and Clay on Windows.
platform/targets/*/*.lib
# scripts/make_windows_import_libs.py writes the committed x64win import libraries.
!platform/targets/x64win/ucrtbase.lib
!platform/targets/x64win/kernel32.lib
!platform/targets/x64win/user32.lib
!platform/targets/x64win/gdi32.lib
!platform/targets/x64win/shell32.lib
!platform/targets/x64win/d3d11.lib
platform/targets/*/*.pdb
# Roc's linker output.
examples/*/*.bin
examples/*/*.exe
examples/*/*.pdb
# lld-link writes an import library beside an exe that exports symbols.
examples/*/*.lib
examples/tutorial/*/*.bin
examples/tutorial/*/*.exe
examples/tutorial/*/*.pdb
examples/tutorial/*/*.lib

.DS_Store
__pycache__/

# Bench game binaries and raw bench output. Summaries are committed elsewhere.
bench/*/*.bin
bench/*/*.exe
bench/*/*.pdb
bench/*/*.lib
bench/out/
