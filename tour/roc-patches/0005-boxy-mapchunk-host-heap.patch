Change: On wasm, the Boxy runtime's mapChunk takes its chunk from the host's
memalign, not from memory.grow behind emscripten's sbrk.
Upstream: not needed. Upstream 0e069d0e7d (2026-11-07) deletes compose.zig.
Drop this patch when the Roc pin moves past 0e069d0e7d.
Source: research/tour-boxy-memory-grow (compose-host-heap.patch).

diff --git a/src/boxy_runtime/compose.zig b/src/boxy_runtime/compose.zig
index 3fd8798..1ef9196 100644
--- a/src/boxy_runtime/compose.zig
+++ b/src/boxy_runtime/compose.zig
@@ -353,10 +353,14 @@ const PlatformImmortals = struct {
     /// Fresh pages. A program's object has no standard library to reach
     /// the kernel through, except on wasm, where memory only grows.
     fn mapChunk(len: usize) ?[*]u8 {
-        if (comptime builtin.cpu.arch.isWasm()) return std.heap.page_allocator.rawAlloc(len, .fromByteUnits(std.heap.pageSize()), @returnAddress());
+        // On wasm the host's libc owns memory.grow; growing behind its sbrk
+        // hands the same pages to both.
+        if (comptime builtin.cpu.arch.isWasm()) return memalign(16, len);
         return raw_pages.map(len);
     }
 
+    extern fn memalign(alignment: usize, size: usize) ?[*]u8;
+
     fn alloc(ops: *RocOps, size: usize, alignment: usize) [*]u8 {
         while (!lock.tryLock()) std.atomic.spinLoopHint();
         defer lock.unlock();
