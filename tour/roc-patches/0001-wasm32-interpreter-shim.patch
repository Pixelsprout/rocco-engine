index 2179ca0..4cdb508 100755
--- a/build.zig
+++ b/build.zig
@@ -5885,6 +5885,41 @@ fn addMainExe(
     // Include the pre-built builtins object
     interpreter_shim_lib.root_module.addObjectFile(builtins_obj.getEmittedBin());
     interpreter_shim_lib.bundle_compiler_rt = true;
+
+    // rocco Tour: the same interpreter shim archive for wasm32-freestanding,
+    // linked into an emscripten host that supplies memalign and free.
+    if (!b.top_level_steps.contains("tour-shim-wasm32-freestanding")) {
+        const tour_target = b.resolveTargetQuery(.{ .cpu_arch = .wasm32, .os_tag = .freestanding });
+        const tour_builtins = addBuiltinsObject(b, roc_modules, "roc_builtins_tour_freestanding", "src/builtins/static_lib.zig", tour_target, optimize, false, false);
+        const tour_shim = b.addLibrary(.{
+            .name = "roc_interpreter_shim_wasm32_freestanding",
+            .root_module = b.createModule(.{
+                .root_source_file = b.path("src/interpreter_shim/main.zig"),
+                .target = tour_target,
+                .optimize = optimize,
+                .strip = program_object_strip,
+                .omit_frame_pointer = program_object_omit_frame_pointer,
+            }),
+            .linkage = .static,
+        });
+        configureBackend(tour_shim, tour_target);
+        tour_shim.root_module.addImport("base", roc_modules.base);
+        tour_shim.root_module.addImport("builtins", roc_modules.builtins);
+        tour_shim.root_module.addImport("eval", roc_modules.eval);
+        tour_shim.root_module.addImport("ipc", roc_modules.ipc);
+        tour_shim.root_module.addImport("layout", roc_modules.layout);
+        tour_shim.root_module.addImport("lir", roc_modules.lir);
+        tour_shim.root_module.addImport("vendor_parse_float", roc_modules.vendor_parse_float);
+        tour_shim.root_module.addImport("vendor_ryu", roc_modules.vendor_ryu);
+        tour_shim.root_module.addImport("shim_io", b.createModule(.{ .root_source_file = b.path("src/shim_io.zig") }));
+        tour_shim.root_module.addImport("shim_host_abi", shim_host_abi_module);
+        tour_shim.root_module.addImport("compiled_builtins", compiled_builtins_module);
+        tour_shim.step.dependOn(&write_compiled_builtins.step);
+        tour_shim.root_module.addObjectFile(tour_builtins.getEmittedBin());
+        tour_shim.bundle_compiler_rt = true;
+        const tour_step = b.step("tour-shim-wasm32-freestanding", "Interpreter shim archive for a wasm32 host (rocco Tour)");
+        tour_step.dependOn(&b.addInstallArtifact(tour_shim, .{}).step);
+    }
     // The link inputs `roc` embeds are digested once here (see
     // src/build/embedded_digests.zig), so `roc run` never rehashes them.
     //
