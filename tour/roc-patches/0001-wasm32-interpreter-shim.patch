 fn allocator() Allocator {
+    if (comptime !has_coordination) return host_heap;
     return std.heap.page_allocator;
 }
 
+/// On wasm32 the host (emscripten) owns `memory.grow`. Zig's wasm page
+/// allocator grows memory behind sbrk's back, so the shim takes its own
+/// memory from the host's malloc instead.
+const host_heap: Allocator = .{ .ptr = undefined, .vtable = &.{
+    .alloc = hostHeapAlloc,
+    .resize = hostHeapResize,
+    .remap = Allocator.noRemap,
+    .free = hostHeapFree,
+} };
+extern fn memalign(alignment: usize, size: usize) ?[*]u8;
+extern fn free(ptr: ?*anyopaque) void;
+fn hostHeapAlloc(_: *anyopaque, len: usize, alignment: std.mem.Alignment, _: usize) ?[*]u8 {
+    return memalign(@max(alignment.toByteUnits(), @sizeOf(usize)), len);
+}
+fn hostHeapResize(_: *anyopaque, memory: []u8, _: std.mem.Alignment, new_len: usize, _: usize) bool {
+    return new_len <= memory.len;
+}
+fn hostHeapFree(_: *anyopaque, memory: []u8, _: std.mem.Alignment, _: usize) void {
+    free(memory.ptr);
+}
