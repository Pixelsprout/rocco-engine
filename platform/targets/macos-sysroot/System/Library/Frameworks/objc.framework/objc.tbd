--- !tapi-tbd
tbd-version: 4
targets: [ arm64-macos ]
install-name: '/usr/lib/libobjc.A.dylib'
exports:
  - targets: [ arm64-macos ]
    symbols:
      - '_OBJC_CLASS_$_NSObject'
      - '_OBJC_METACLASS_$_NSObject'
      - '__objc_empty_cache'
      - '_objc_alloc'
      - '_objc_autoreleasePoolPop'
      - '_objc_autoreleasePoolPush'
      - '_objc_msgSend'
      - '_objc_msgSendSuper2'
      - '_objc_release'
      - '_objc_retain'
...
