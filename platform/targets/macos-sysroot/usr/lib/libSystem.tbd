--- !tapi-tbd
tbd-version: 4
targets: [ arm64-macos ]
install-name: '/usr/lib/libSystem.B.dylib'
exports:
  - targets: [ arm64-macos ]
    symbols:
      - '__NSConcreteGlobalBlock'
      - '__NSGetExecutablePath'
      - '___assert_rtn'
      - '___chkstk_darwin'
      - '___error'
      - '___exp10'
      - '___memcpy_chk'
      - '___memmove_chk'
      - '___memset_chk'
      - '___sincos_stret'
      - '___sincosf_stret'
      - '___stack_chk_fail'
      - '___stack_chk_guard'
      - '___stderrp'
      - '___ulock_wait'
      - '___ulock_wait2'
      - '___ulock_wake'
      - '___vsnprintf_chk'
      - '__availability_version_check'
      - '__tlv_bootstrap'
      - '_abort'
      - '_accept'
      - '_arc4random_buf'
      - '_bind'
      - '_bzero'
      - '_calloc'
      - '_clock_gettime'
      - '_close'
