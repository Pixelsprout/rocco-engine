      - '_fread'
      - '_free'
      - '_fseek'
      - '_fstat'
      - '_fstatat'
      - '_fsync'
      - '_ftell'
      - '_fwrite'
      - '_getenv'
      - '_isatty'
      - '_ldexp'
      - '_listen'
      - '_log'
