      - '_closedir'
      - '_cos'
      - '_cosf'
      - '_dirfd'
      - '_dispatch_data_create'
      - '_dispatch_once_f'
      - '_dispatch_semaphore_create'
      - '_dispatch_semaphore_signal'
      - '_dispatch_semaphore_wait'
      - '_dlclose'
      - '_dlopen'
      - '_dlsym'
      - '_dup'
      - '_exit'
      - '_exp'
      - '_fclose'
      - '_fcntl'
      - '_fdopendir'
      - '_feof'
      - '_ferror'
      - '_fgetc'
      - '_fileno'
      - '_fmod'
