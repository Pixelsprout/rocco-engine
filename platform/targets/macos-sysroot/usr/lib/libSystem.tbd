      - '_pthread_attr_setinheritsched'
      - '_pthread_attr_setschedparam'
      - '_pthread_attr_setschedpolicy'
      - '_pthread_attr_setstacksize'
      - '_pthread_cond_destroy'
      - '_pthread_cond_init'
      - '_pthread_cond_signal'
      - '_pthread_cond_wait'
      - '_pthread_create'
      - '_pthread_join'
