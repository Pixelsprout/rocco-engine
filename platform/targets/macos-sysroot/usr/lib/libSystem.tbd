--- !tapi-tbd
tbd-version: 4
targets: [ arm64-macos ]
install-name: '/usr/lib/libSystem.B.dylib'
exports:
  - targets: [ arm64-macos ]
    symbols:
      - '__NSConcreteGlobalBlock'
      - '__NSGetExecutablePath'
      - '___assert_rtn'
      - '___chkstk_darwin'
      - '___error'
      - '___memcpy_chk'
      - '___memset_chk'
      - '___sincosf_stret'
      - '___stack_chk_fail'
      - '___stack_chk_guard'
      - '___stderrp'
      - '___ulock_wait'
      - '___ulock_wait2'
      - '___ulock_wake'
      - '__availability_version_check'
      - '__tlv_bootstrap'
      - '_abort'
      - '_accept'
      - '_arc4random_buf'
      - '_bind'
      - '_bzero'
      - '_calloc'
      - '_clock_gettime'
      - '_close'
      - '_close$NOCANCEL'
      - '_closedir'
      - '_cosf'
      - '_dirfd'
      - '_dispatch_data_create'
      - '_dispatch_once_f'
      - '_dispatch_semaphore_create'
      - '_dispatch_semaphore_signal'
      - '_dispatch_semaphore_wait'
      - '_dlsym'
      - '_dup'
      - '_exit'
      - '_fclose'
      - '_fcntl'
      - '_fdopendir'
      - '_fmod'
      - '_fmodf'
      - '_fopen'
      - '_fputs'
      - '_fread'
      - '_free'
      - '_fseek'
      - '_fstat'
      - '_fstatat'
      - '_fsync'
      - '_ftell'
      - '_getenv'
      - '_isatty'
      - '_listen'
      - '_lseek'
      - '_mach_absolute_time'
      - '_mach_timebase_info'
      - '_malloc'
      - '_memcpy'
      - '_memmove'
      - '_memset'
      - '_memset_pattern16'
      - '_mmap'
      - '_mprotect'
      - '_munmap'
      - '_nanosleep'
      - '_open'
      - '_openat'
      - '_os_unfair_lock_lock'
      - '_os_unfair_lock_trylock'
      - '_os_unfair_lock_unlock'
      - '_powf'
      - '_pread'
      - '_pthread_threadid_np'
      - '_pwrite'
      - '_read'
      - '_readdir'
      - '_realloc'
      - '_recv'
      - '_rewind'
      - '_send'
      - '_setsockopt'
      - '_sinf'
      - '_socket'
      - '_sscanf'
      - '_strerror'
      - '_strlen'
      - '_sys_icache_invalidate'
      - '_sysconf'
      - '_write'
      - 'dyld_stub_binder'
...
